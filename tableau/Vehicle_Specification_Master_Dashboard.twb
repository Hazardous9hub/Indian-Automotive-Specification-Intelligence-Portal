      <column caption='Brand1' datatype='string' name='[Brand]' role='dimension' type='nominal' />

      <column caption='Price in Lakhs (INR)' datatype='real' default-format='c&quot;₹ &quot;#,##0.0&quot;L&quot;;&quot;₹ &quot;-#,##0.0&quot;L&quot;' name='[Calculation_0666902409752576]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='[price_inr] / 100000' />

      </column>

      <column caption='Powertrain Group' datatype='string' name='[Calculation_0666902410113025]' role='dimension' type='nominal'>

        <calculation class='tableau' formula='// Groups fuel types into high-level powertrain architectures&#13;&#10;IF [fuel_type] = &quot;Electric&quot; THEN &quot;Pure Electric (EV)&quot;&#13;&#10;ELSE &quot;Internal Combustion Engine (ICE)&quot;&#13;&#10;END' />

      </column>

      <column caption='Safety Category Tier' datatype='string' name='[Calculation_0666902410600450]' role='dimension' type='nominal'>

        <calculation class='tableau' formula='// Categorizes vehicles by combined passive and active safety&#13;&#10;IF [safety_rating] &gt;= 4 AND [airbags] &gt;= 6 THEN &quot;High Safety (4-5★, 6+ Airbags)&quot;&#13;&#10;ELSEIF [safety_rating] &gt;= 3 THEN &quot;Standard Safety (3★, 2-5 Airbags)&quot;&#13;&#10;ELSE &quot;Basic Safety (2★, &lt;2 Airbags)&quot;&#13;&#10;END' />

      </column>

      <column caption='Category Avg Price (INR)' datatype='real' default-format='c&quot;₹ &quot;#,##0.00&quot;L&quot;;&quot;₹ &quot;-#,##0.00&quot;L&quot;' name='[Calculation_0666902413213699]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='{ FIXED  [vehicle_category]: AVG([price_inr])} / 100000' />

      </column>

      <column caption='Price v/s Category Benchmark (%)' datatype='real' name='[Calculation_0666902413819908]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='(([price_inr]/100000) - [Calculation_0666902413213699]) / [Calculation_0666902413213699]' />

      </column>

      <column caption='HP per Lakh INR ' datatype='real' name='[Calculation_0666902415237125]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='// Value for MOney Metric &#13;&#10;ROUND([horsepower_hp]/([price_inr]/100000), 2)' />

      </column>

      <column caption='kpi_catalog_size' datatype='integer' name='[Calculation_0666902416814086]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='count([model])' />

      </column>

      <column caption='kpi_avg_price' datatype='real' name='[Calculation_0666902417055751]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='avg([Calculation_0666902409752576])' />

      </column>

      <column caption='kpi_avg_mileage_range' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0666902417166344]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='avg(if  [fuel_type]!= &quot;Electric&quot; then [mileage_kmpl] ELSE [ev_range_km] END)' />

      </column>

      <column caption='KPI_Total_Models' datatype='integer' name='[Calculation_1088842047442944]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='COUNTD([model])' />

      </column>

      <column caption='KPI_top_safety_pct' datatype='real' name='[Calculation_1088842048282625]' role='measure' type='quantitative'>

        <calculation class='tableau' formula='COUNT(IF [safety_rating] &gt;= 4 THEN [vehicle_id] END) / COUNT([vehicle_id]) * 100' />

      </column>

